#include <windows.h>
1 RT_MANIFEST "@PROJECT_SOURCE_DIR@/platform/windows.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "whh110112"
   VALUE "FileDescription", "ZENzip Native"
   VALUE "FileVersion", "@ZENZIP_VERSION_FULL@"
   VALUE "ProductName", "ZENzip"
   VALUE "ProductVersion", "@ZENZIP_VERSION_FULL@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
