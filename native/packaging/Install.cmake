if(WIN32)
  set(CMAKE_INSTALL_BINDIR ".")
  set(QT_DEPLOY_BIN_DIR ".")
endif()
include(GNUInstallDirs)
if(APPLE)
  install(TARGETS zenzip BUNDLE DESTINATION . COMPONENT Runtime)
  install(TARGETS zenzip-worker RUNTIME DESTINATION zenzip.app/Contents/MacOS COMPONENT Runtime)
  install(FILES "${ZENZIP_ENGINE_DIR}/${ZENZIP_ENGINE_FILE}" DESTINATION zenzip.app/Contents/MacOS/engine COMPONENT Runtime)
  set_target_properties(zenzip-worker PROPERTIES INSTALL_RPATH "@executable_path/../Frameworks")
else()
  install(TARGETS zenzip zenzip-worker RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}" COMPONENT Runtime)
  install(FILES "${ZENZIP_ENGINE_DIR}/${ZENZIP_ENGINE_FILE}" DESTINATION "${CMAKE_INSTALL_BINDIR}/engine" COMPONENT Runtime)
  if(UNIX)
    set_target_properties(zenzip zenzip-worker PROPERTIES INSTALL_RPATH "$ORIGIN/../lib")
  endif()
endif()
qt_generate_deploy_qml_app_script(TARGET zenzip OUTPUT_SCRIPT deployment)
if(WIN32)
  install(CODE "set(QT_DEPLOY_BIN_DIR .)" COMPONENT Runtime)
endif()
if(NOT (WIN32 AND CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64"))
  install(SCRIPT "${deployment}" COMPONENT Runtime)
endif()
# Qt 6.8's ARM64 SDK has x64 host deployment tools. package.py explicitly
# passes the target qtpaths.bat instead of accidentally copying host DLLs.
