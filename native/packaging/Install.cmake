if(WIN32)
  set(CMAKE_INSTALL_BINDIR ".")
  set(QT_DEPLOY_BIN_DIR ".")
endif()
include(GNUInstallDirs)
if(APPLE)
  install(TARGETS reazip BUNDLE DESTINATION . COMPONENT Runtime)
  install(TARGETS reazip-worker RUNTIME DESTINATION reazip.app/Contents/MacOS COMPONENT Runtime)
  install(FILES "${REAZIP_ENGINE_DIR}/${REAZIP_ENGINE_FILE}" DESTINATION reazip.app/Contents/MacOS/engine COMPONENT Runtime)
  set_target_properties(reazip-worker PROPERTIES INSTALL_RPATH "@executable_path/../Frameworks")
else()
  install(TARGETS reazip reazip-worker RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}" COMPONENT Runtime)
  install(FILES "${REAZIP_ENGINE_DIR}/${REAZIP_ENGINE_FILE}" DESTINATION "${CMAKE_INSTALL_BINDIR}/engine" COMPONENT Runtime)
  if(UNIX)
    set_target_properties(reazip reazip-worker PROPERTIES INSTALL_RPATH "$ORIGIN/../lib")
  endif()
endif()
qt_generate_deploy_qml_app_script(TARGET reazip OUTPUT_SCRIPT deployment)
if(WIN32)
  install(CODE "set(QT_DEPLOY_BIN_DIR .)" COMPONENT Runtime)
endif()
install(SCRIPT "${deployment}" COMPONENT Runtime)
